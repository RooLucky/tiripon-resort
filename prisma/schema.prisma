// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  @@map("users")
}

model Subscribers {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model ContactUs {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_us")
}

model Booking {
  id                  String    @id @default(uuid())
  name                String
  email               String?
  phone               String?
  selected_cottage_id String?
  receipt             Receipt?
  number_of_adult     String
  number_of_kids      String
  total_price         Float
  deleted             Boolean?  @default(false)
  deletedAt           DateTime?
  summary             String?
  checkIn             DateTime?
  checkOut            DateTime?
  createdAt           DateTime  @default(now())

  @@map("bookings")
}

model Receipt {
  id                   String    @id @default(uuid())
  booking              Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId            String    @unique
  downPaymentAmount    Float
  status               String    @default("pending")
  fullyPaid            Boolean   @default(false)
  receipt_confirmation Boolean?  @default(false)
  proofFilePath        String?
  proofFileName        String?
  proofMimeType        String?
  proofViewUrl         String?
  proofUploadedAt      DateTime?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("receipts")
}

model Cottages {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  capacity    String
  createdAt   DateTime @default(now())
  imageUrl    String?
  quantity    Int?     @default(1)

  @@map("cottages")
}

model DefaultChatNodes {
  id        String   @id @default(uuid())
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@map("default_chat_nodes")
}
